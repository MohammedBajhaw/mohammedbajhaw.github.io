# The only service reachable from outside. SITE_ADDRESS is your domain (HTTPS and certificates are automatic),
# or http://localhost for a local trial.
{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	# Large uploads (images, videos up to 50 MB, documents) go straight to the API.
	request_body /api/uploads {
		max_size 55MB
	}

	@api path /api/* /uploads/*
	handle @api {
		reverse_proxy server:4000
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
