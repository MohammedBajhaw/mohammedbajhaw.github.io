# Copy to .env (never commit it) and fill in.

# The address visitors use. A real domain gets HTTPS automatically (its DNS must point to this server).
SITE_ADDRESS=example.com
PUBLIC_URL=https://example.com

# Secrets
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=you@example.com
# Use a bcrypt hash in production (single quotes, because the hash contains "$"). ADMIN_PASSWORD is the simple alternative.
# ADMIN_PASSWORD_HASH='$2a$12$...'
ADMIN_PASSWORD=change-me

# Optional: translation provider defaults (also editable in the studio under Translation)
# LLM_API_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini

# Only for a local trial on a machine where 80/443 are taken:
# HTTP_PORT=8088
# HTTPS_PORT=8443
