{
  "name": "mohammed-bajhaw-server",
  "version": "1.0.0",
  "description": "NestJS (Express) + MongoDB backend API for Mohammed Bajhaw Portfolio",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"src/**/*.ts\"",
    "check": "tsc --noEmit && pnpm run lint",
    "test:unit": "tsc -p tsconfig.test.json && node -r ./test/bootstrap-paths.js --test dist-test/test/unit/*.spec.js",
    "test:integration": "tsc -p tsconfig.test.json && node -r ./test/bootstrap-paths.js --test dist-test/test/integration/*.spec.js",
    "test": "pnpm run test:unit && pnpm run test:integration"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/mongoose": "^11.0.2",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/throttler": "^6.8.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.0.0",
    "mongoose": "^8.9.5",
    "multer": "^2.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.2",
    "@nestjs/schematics": "^11.0.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.5",
    "eslint": "^10.15.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.73.0"
  }
}
